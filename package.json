{
  "name": "blast-radius",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @blast-radius/api run test",
    "dev": "pnpm -r --parallel run dev",
    "db:migrate": "pnpm --filter @blast-radius/api run db:migrate",
    "seed": "pnpm --filter @blast-radius/api run seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
